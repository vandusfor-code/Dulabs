# WhatsApp Worker (Fase 9B) -- proceso persistente que sostiene las
# sesiones Baileys (Vercel serverless no puede mantener el WebSocket).

# Supabase (mismo proyecto que Vercel -- Project Settings -> API). El worker
# lee/escribe SOLO dulabs_whatsapp_qr_sesiones con la service role key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secreto compartido con Vercel (variable WHATSAPP_WORKER_SECRET allá
# también, mismo valor exacto). Protege toda ruta salvo GET /salud --
# generar UNA vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_WORKER_SECRET=

# Puerto HTTP del worker. Railway inyecta su propio PORT automáticamente --
# dejar vacío en Railway, usar 3000 en local.
PORT=3000
