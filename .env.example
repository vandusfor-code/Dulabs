# URL pública del sitio (usada por ej. en el link de redirección de las
# invitaciones de equipo — supabase.auth.admin.inviteUserByEmail).
NEXT_PUBLIC_SITE_URL=https://dulabs.co

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # clave pública (anon), protegida por RLS — segura de exponer al cliente

# WhatsApp Worker (Fase 9B) -- proceso persistente (Railway u otro, ver
# worker/) que sostiene las sesiones Baileys; Vercel serverless no puede
# mantener ese WebSocket. Usado solo server-side (lib/whatsapp-worker-client.ts),
# nunca llega al navegador. WHATSAPP_WORKER_SECRET debe ser EXACTAMENTE el
# mismo valor que WHATSAPP_WORKER_SECRET en el entorno del worker.
WHATSAPP_WORKER_URL=https://xxxx.up.railway.app
WHATSAPP_WORKER_SECRET=

# Cifra meta_permanent_token y api_key_ia antes de guardarlos (ver lib/crypto.ts)
# — así un dump de la base o la service-role key filtrada no exponen los
# tokens en texto plano. Generar UNA vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guardar el mismo valor en Vercel y nunca rotarlo sin antes descifrar los
# valores existentes con la clave vieja.
TOKEN_ENCRYPTION_KEY=

# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=un-token-secreto-que-tu-eliges
META_ACCESS_TOKEN=EAAG...   # System User token con whatsapp_business_messaging
META_GRAPH_VERSION=v23.0

# Reenvío a DuMo (CRM externo que comparte la misma Meta App/webhook): si
# ambas faltan, el reenvío queda inactivo sin afectar el resto del webhook.
# Integración DuMo (CRM externo — reenvío de webhooks + bandeja de asesores)
DUMO_FORWARD_SECRET=   # debe coincidir con WHATSAPP_FORWARD_SECRET en du-mo.vercel.app
DUMO_PHONE_NUMBER_ID=  # opcional / legacy: IDs coma-separados que siempre reenvían (ej. 1058034444062074)

# Transferencia de leads capturados por campaña (POST /api/whatsapp/lead-intake
# en DuMo) -- distinto de DUMO_FORWARD_SECRET (ese es para el reenvío crudo de
# mensajes WhatsApp, este es solo para el payload estructurado del lead ya
# capturado). Debe coincidir con DULABS_LEAD_INTAKE_SECRET en du-mo.vercel.app.
DULABS_LEAD_INTAKE_SECRET=

# IA por defecto de la plataforma (si el cliente no trae su propia api_key_ia)
ANTHROPIC_API_KEY=sk-ant-...

# Alertas internas por WhatsApp (ej. "la IA dejó de responder"). Es un número
# de la propia plataforma, NO un número de cliente: por eso vive aquí y no en
# dulabs_clientes_config — así no aparece en el panel ni consume cupo de plan.
# El token es de un System User de Meta (no expira). Si las tres faltan, las
# alertas quedan solo en los logs y nada más se rompe.
ALERTAS_PHONE_NUMBER_ID=   # phone_number_id del número que ENVÍA las alertas
ALERTAS_META_TOKEN=        # token del System User con acceso a ese número
ALERTAS_DESTINO=           # número que RECIBE las alertas, solo dígitos (ej. 573148127388)

# DuMo es una integración interna del operador (reenvía un número a un CRM
# externo propio), NO una función del producto. Solo estos correos ven y
# pueden usar el botón "Conectar con DuMo". Separados por coma. Si queda
# vacía, DuMo queda oculto para TODOS — se prefiere apagado a abierto.
DUMO_ADMIN_EMAILS=

# Embedded Signup v4 (Meta for Developers → tu app)
NEXT_PUBLIC_META_APP_ID=1234567890
NEXT_PUBLIC_META_CONFIG_ID=2187855688668857
META_APP_SECRET=abc123...
# DuLabs Developer V1 (Fase 10) — Embedded Signup del producto Developer.
# Reutiliza la MISMA Meta App verificada (NEXT_PUBLIC_META_APP_ID +
# META_APP_SECRET de arriba). Solo el config_id puede ser propio de Developer.
# OPCIONAL: si se deja vacío, el onboarding Developer cae al
# NEXT_PUBLIC_META_CONFIG_ID de Business (mismos scopes) — no se inventa
# configuración de Meta. Defínelo solo si creas un config dedicado de
# Developer dentro de la misma App.
NEXT_PUBLIC_META_DEV_CONFIG_ID=

# Pagos recurrentes (Wompi — comercios.wompi.co → Desarrolladores)
# Usa las llaves test_ en Sandbox antes de pasar a prod_ en producción.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_KEY=...   # para verificar la firma de los webhooks de Wompi
WOMPI_INTEGRITY_KEY=...   # para firmar la creación de transacciones (campo "signature")
CRON_SECRET=un-secreto-que-tu-eliges   # protege /api/wompi/cobro-mensual y sirve de respaldo para /api/cron/encuestas-seguimiento
PLATFORM_ADMIN_SECRET=otro-secreto-que-tu-eliges   # protege /api/admin/activar-suscripcion (activar un plan negociado a mano, ej. Enterprise, para CUALQUIER tenant)

# QStash (console.upstash.com → QStash → Signing Keys) — dispara
# /api/cron/encuestas-seguimiento con precisión real, sin depender del límite
# de 1 vez/día del plan Hobby de Vercel para sus crons nativos.
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Protege /api/diagnostics/token-status (comparación en tiempo constante)
DIAGNOSTICS_SECRET=un-secreto-que-tu-eliges

# Analytics de marketing (opcional — dejar vacío hasta configurar IDs reales)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# =====================================================================
# DuLabs Developer V1 (producto CPaaS separado de Business/AMORE)
# Fase 18 (Production Readiness): inventario COMPLETO de variables que usa
# Developer V1. NUNCA poner valores reales aquí. "Scope" indica DÓNDE debe
# existir cada una (Vercel = app Next; Cloud Run = gateway/workers/reconcil.).
# =====================================================================

# --- Cifrado de tokens de Developer (Vercel + Cloud Run) ---
# Clave maestra estática (base64 de 32 bytes) para cifrar/descifrar los tokens
# de Meta de Developer. El guard de release BLOQUEA el build si falta (ver
# lib/config/release-crypto-config.ts). Generar UNA vez:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Alternativa KMS (si se usa en vez de la clave estática):
DEVELOPER_TOKEN_ENCRYPTION_KEY=
# KMS_KEY_NAME=projects/.../locations/.../keyRings/.../cryptoKeys/...   # opcional (mecanismo kms)

# --- Gateway público /api/v1 (Cloud Run) ---
# Nº de proxies confiables al FINAL de X-Forwarded-For (Fase 17.2). Cloud Run
# directo suele ser 0; detrás de un HTTPS LB externo adicional puede ser 1.
# VERIFICAR contra la topología real del despliegue.
GATEWAY_TRUSTED_PROXIES=0
# Kill switch operativo del API público (Fase 19). Fail-safe a HABILITADO:
# solo se apaga con un valor explícito falsy ("false"/"0"/"off"/"no"). Apagarlo
# rechaza TODO /api/v1 autenticado con 503 (emergencia/mantenimiento) sin deploy.
DEVELOPER_API_ENABLED=true

# --- Billing Developer (Vercel) — Wompi comercio SEPARADO del de Business ---
DEVELOPER_BILLING_ENABLED=false            # OFF conserva el comportamiento de Fase 11
DEVELOPER_BILLING_USD_COP_RATE=            # tasa FX server-side (fail-closed: sin esto no se cobra)
NEXT_PUBLIC_DEVELOPER_WOMPI_PUBLIC_KEY=pub_test_...   # pública (tokenización en el navegador)
DEVELOPER_WOMPI_PRIVATE_KEY=prv_test_...              # NUNCA al cliente
DEVELOPER_WOMPI_INTEGRITY_KEY=                        # firma de creación de transacciones
DEVELOPER_WOMPI_EVENTS_KEY=                           # verificación de firma de webhooks Wompi Developer
NEXT_PUBLIC_DEVELOPER_SALES_EMAIL=                    # CTA Enterprise (fallback contacto@dulabs.co)

# --- Meta / WhatsApp Cloud API para Developer (Cloud Run workers/gateway) ---
# Reusa META_APP_SECRET de arriba (misma Meta App). Base URL/versión del Graph:
META_GRAPH_API_BASE_URL=https://graph.facebook.com   # base del Graph API (workers outbound)
# META_GRAPH_VERSION ya definido arriba (compartido).

# --- Pub/Sub + proyecto GCP (Cloud Run) ---
GCP_PROJECT=dulabs-developer-v1            # id del proyecto GCP de Developer
PUBSUB_TOPIC_INBOUND=                       # topic de eventos entrantes (Meta -> worker-inbound)
PUBSUB_TOPIC_OUTBOUND=                      # topic de jobs salientes (gateway -> worker-outbound)

# --- Compartidas con Business (ya definidas arriba): SUPABASE_URL,
#     SUPABASE_SERVICE_ROLE_KEY, META_APP_SECRET, CRON_SECRET, DIAGNOSTICS_SECRET ---
# CRON_SECRET protege también /api/developer/billing/cobro-recurrente y
# /api/developer/maintenance/retencion (Vercel Cron manda Bearer CRON_SECRET).
